set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE6E22C8

# ---------------------------------------------------------------------------
# CHANGED: top-level entity is proto_fc3_top, not malaria_top.
# There is no malaria_top wrapper in this build - proto_fc3_top's own ports
# (clk, rst_n, start_n, seg, dig_sel, led_green, buzzer, done_led) are wired
# directly to board pins below.
# ---------------------------------------------------------------------------
set_global_assignment -name TOP_LEVEL_ENTITY proto_fc3_top

set_global_assignment -name ORIGINAL_QUARTUS_VERSION 22.1STD.2
set_global_assignment -name LAST_QUARTUS_VERSION "22.1std.2 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 1
set_global_assignment -name NOMINAL_CORE_SUPPLY_VOLTAGE 1.2V
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top

# =============================================================================
# SOURCE FILES
# =============================================================================
# REMOVED vs. your prior .qsf: malaria_top.sv is not part of this build (no
# wrapper - proto_fc3_top IS the top level). Everything else kept as-is.

# NOTE (unresolved from simulation log): fc3_weight_rom.sv / fc3_bias_rom.sv
# must have weights_malaria.mem / biases_malaria.mem as the ACTIVE (uncommented)
# $readmemh target. Your last ModelSim run showed fc3_weights.mem / fc3_biases.mem
# (the original 10-class MNIST files) being loaded instead - these two files
# are kept in the project below for reference/compatibility only and must NOT
# be the active readmemh target for this malaria build.


# =============================================================================
# TIMING CONSTRAINTS
# =============================================================================
# NEW: was missing entirely from the prior .qsf. Port names below match
# proto_fc3_top.sv directly (see accompanying proto_fc3_top.sdc).

# =============================================================================
# PIN ASSIGNMENTS
# NEW: prior .qsf had zero location assignments. All pins below are taken
# directly from Development_board_pin_information.xls.
# =============================================================================

# Clock / reset / start (proto_fc3_top's own top-level ports)
set_location_assignment PIN_23  -to clk
set_location_assignment PIN_25  -to rst_n
set_location_assignment PIN_88  -to start_n

# 4-digit multiplexed 7-segment: digit selects (DIG1..DIG4)
set_location_assignment PIN_137 -to dig_sel[0]
set_location_assignment PIN_136 -to dig_sel[1]
set_location_assignment PIN_135 -to dig_sel[2]
set_location_assignment PIN_133 -to dig_sel[3]

# Segments a..g (assumption: SEG0=a ... SEG6=g - pin sheet gives numbers only,
# not segment letters; verify on first bring-up)
set_location_assignment PIN_128 -to seg[0]
set_location_assignment PIN_121 -to seg[1]
set_location_assignment PIN_125 -to seg[2]
set_location_assignment PIN_129 -to seg[3]
set_location_assignment PIN_132 -to seg[4]
set_location_assignment PIN_126 -to seg[5]
set_location_assignment PIN_124 -to seg[6]
# SEG7 / PIN_127 is the decimal point - intentionally left unconnected

# LEDs (assumption: led1=green health indicator, led2=inference-done LED -
# pin sheet does not label colors; confirm on silkscreen)
set_location_assignment PIN_86 -to led_green
set_location_assignment PIN_87 -to done_led

# Buzzer
set_location_assignment PIN_110 -to buzzer

# Default I/O standard for all the above (typical for this board's 3.3V bank)
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to rst_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to start_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dig_sel[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dig_sel[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dig_sel[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dig_sel[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to seg[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led_green
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to done_led
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to buzzer

# =============================================================================
# POWER / EDA SETTINGS (unchanged from prior .qsf)
# =============================================================================
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim (Verilog)"
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_ENABLE_STATUS TEST_BENCH_MODE -section_id eda_simulation
set_global_assignment -name EDA_NATIVELINK_SIMULATION_TEST_BENCH tb_proto_fc3_top -section_id eda_simulation

set_global_assignment -name EDA_TEST_BENCH_NAME tb_proto_fc3_top -section_id eda_simulation
set_global_assignment -name EDA_DESIGN_INSTANCE_NAME NA -section_id tb_proto_fc3_top
set_global_assignment -name EDA_TEST_BENCH_MODULE_NAME tb_proto_fc3_top -section_id tb_proto_fc3_top
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_timing
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_symbol
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_signal_integrity
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_boundary_scan
set_global_assignment -name SYSTEMVERILOG_FILE tb_proto_fc3_top.sv
set_global_assignment -name SOURCE_FILE fc3_weights.mem
set_global_assignment -name SOURCE_FILE fc3_biases.mem
set_global_assignment -name SOURCE_FILE fc2_golden_reference_un.mem
set_global_assignment -name SOURCE_FILE fc2_golden_reference_mal.mem
set_global_assignment -name SOURCE_FILE biases_malaria.mem
set_global_assignment -name SOURCE_FILE weights_malaria.mem
set_global_assignment -name SDC_FILE proto_fc3_top.sdc
set_global_assignment -name SYSTEMVERILOG_FILE fc3_controller_RECOMMENDED_FIX.sv
set_global_assignment -name SYSTEMVERILOG_FILE layer_processor_fc3_proto.sv
set_global_assignment -name SYSTEMVERILOG_FILE final_top_module.sv
set_global_assignment -name SYSTEMVERILOG_FILE argmax_7segmalaria.sv
set_global_assignment -name SYSTEMVERILOG_FILE lenet5_npu_complete.sv
set_global_assignment -name SYSTEMVERILOG_FILE weight2.sv
set_global_assignment -name SYSTEMVERILOG_FILE systolic_full.sv
set_global_assignment -name SYSTEMVERILOG_FILE requantization_block.sv
set_global_assignment -name SYSTEMVERILOG_FILE input_output_sram.sv
set_global_assignment -name SYSTEMVERILOG_FILE im2col1.sv
set_global_assignment -name SYSTEMVERILOG_FILE fc3_weight_rom.sv
set_global_assignment -name SYSTEMVERILOG_FILE fc3_bias_rom.sv
set_global_assignment -name SYSTEMVERILOG_FILE fc2_output_rom.sv
set_global_assignment -name SYSTEMVERILOG_FILE conv_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE conv_controller.sv
set_global_assignment -name SYSTEMVERILOG_FILE conv_bias_requant_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE conv_bias.sv
set_global_assignment -name SYSTEMVERILOG_FILE avg_pooling.sv
set_global_assignment -name SYSTEMVERILOG_FILE proto_fc3_top.sv
set_global_assignment -name EDA_TEST_BENCH_FILE tb_proto_fc3_top.sv -section_id tb_proto_fc3_top
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top